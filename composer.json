{
    "name": "ignite/ignite",
    "type": "project",
    "description": "Ticketing/helpdesk or basic forum platform framework",
    "keywords": [
        "ignite",
        "ticketing",
        "helpdesk",
        "forum"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mailparse": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "aws/aws-sdk-php": "^3.301.3",
        "aws/aws-sdk-php-laravel": "^3.9.0",
        "barryvdh/laravel-dompdf": "^2.1.1",
        "doctrine/dbal": "^4.0.1",
        "erusev/parsedown": "^1.7.4",
        "ezyang/htmlpurifier": "^4.17",
        "geocoder-php/google-maps-provider": "^4.7.1",
        "geocoder-php/nominatim-provider": "^5.7.0",
        "giggsey/libphonenumber-for-php": "^8.13.32",
        "graham-campbell/security": "^v11.2.0",
        "guzzlehttp/guzzle": "^7.8.1",
        "hashids/hashids": "^5.0.2",
        "inertiajs/inertia-laravel": "^1.2.0",
        "jerome/filterable": "^1.1",
        "kevinrob/guzzle-cache-middleware": "^5.1.0",
        "laravel/framework": "^v11.0.7",
        "laravel/jetstream": "^5.0.0",
        "laravel/pennant": "^1.7.0",
        "laravel/prompts": "^v0.1.16",
        "laravel/sanctum": "^4.0.0",
        "laravel/scout": "^v10.8.3",
        "laravel/slack-notification-channel": "^3.2.0",
        "laravel/socialite": "^v5.12.1",
        "laravel/tinker": "^2.9.0",
        "league/commonmark": "^2.4.2",
        "league/csv": "^9.15.0",
        "league/flysystem-aws-s3-v3": "^3.25.1",
        "matanyadaev/laravel-eloquent-spatial": "^4.2.0",
        "mikehaertl/php-pdftk": "^0.13.1",
        "moneyphp/money": "^4.5.0",
        "php-http/guzzle7-adapter": "^1.0",
        "php-mime-mail-parser/php-mime-mail-parser": "^1.0",
        "phpoffice/phpword": "^1.1",
        "pion/laravel-chunk-upload": "^1.5.3",
        "smalot/pdfparser": "^2.9.0",
        "spatie/laravel-cookie-consent": "^3.3.0",
        "spatie/laravel-csp": "^2.9.0",
        "spatie/laravel-medialibrary": "^11.4.6",
        "spatie/laravel-pdf": "^1.4.0",
        "symfony/http-client": "^7.0.5",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.3",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^2.7",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "nunomaduro/phpinsights": "^2.11",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.4",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Ignite\\": "src/Ignite/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "analyse": "chmod +x bin/analysis.sh && ./bin/analysis.sh",
        "lint": "chmod +x bin/lint.sh && ./bin/lint.sh",
        "fix": "chmod +x bin/fix.sh && ./bin/fix.sh"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
