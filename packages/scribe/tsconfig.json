{
    "root": true,
    "extends": "tsconfig/base.json",
    "exclude": [
        "node_modules",
        "dist",
        // "./tests/**/*.test.ts",
        // "./tests/**/*.spec.ts",
    ],
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx"
    ],
    "compilerOptions": {
        "experimentalDecorators": true,
        "outDir": "dist",
        "sourceMap": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "rootDir": "./",
        "baseUrl": "./src",
        "paths": {
            "@/*": [
                "./*"
            ],
        },
        "types": [
            "node",
            "vitest/globals"
        ],
        "typeRoots": [
            "./types",
            "./node_modules/@types"
        ]
    }
}
