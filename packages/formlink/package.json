{
    "name": "@ignite/formlink",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/formlink.umd.js",
    "module": "./dist/formlink.es.js",
    "types": "./types/index.d.ts",
