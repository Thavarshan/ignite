        "formdata-node": "^5.0.0",
        "lodash": "^4.17.21",
        "object-to-formdata": "^4.4.2",
        "ts-node": "^10.9.1"
    },
    "devDependencies": {
        "@types/jsdom": "^20.0.1",
        "@types/lodash": "^4.14.191",
        "axios-mock-adapter": "^1.21.2",
        "eslint-config-custom": "*",
        "jsdom": "^21.1.0",
        "tsconfig": "*",
        "typescript": "^4.9.5",
        "vite": "^4.1.1",
        "vite-plugin-dts": "^1.7.2",
        "vitest": "^0.28.4"
