includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/
        - src/Ignite

    level: 4

    excludePaths:
        - ./src/Ignite/Shared/Traits/Personable.php
        - ./src/Ignite/Shared/Traits/Hashable.php
        - ./src/Ignite/Shared/Traits/Sluggable.php
        - ./src/Ignite/Shared/Data/Traits/Entity.php
        - ./src/Ignite/Shared/Data/Traits/Filterable.php
        - ./src/Ignite/Shared/Data/Traits/Fillable.php
        - ./src/Ignite/Setup/Actions/SetupDefaults.php
        - ./src/Ignite/Billing
        - ./src/Ignite/Persons

    checkMissingIterableValueType: false
    treatPhpDocTypesAsCertain: false
